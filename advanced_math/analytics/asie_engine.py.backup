import numpy as np
import scipy.linalg as la
import scipy.stats as stats

class ASIEEngine:
    def __init__(self, num_signals, max_lags=3, alpha=0.01):
        self.num_signals = num_signals
        self.max_lags = max_lags
        self.alpha = alpha

    def predict(self, history):
        Y, X = self._construct_design_matrix(history)

        ridge = 1e-3
        B = la.inv(X.T @ X + np.eye(X.shape[1]) * ridge) @ X.T @ Y

        current = []
        for l in range(1, self.max_lags + 1):
            current.extend(history[-l, :])

        forecast = np.array(current).reshape(1, -1) @ B

        causal = self._compute_causal_matrix(Y, X, B)

        return forecast.flatten(), causal

    def _construct_design_matrix(self, data):
        n, k = data.shape
        samples = n - self.max_lags

        Y = data[self.max_lags:, :]
        X = np.zeros((samples, k * self.max_lags))

        for t in range(samples):
            row = []
            for lag in range(1, self.max_lags + 1):
                row.extend(data[t + self.max_lags - lag, :])
            X[t] = row

        return Y, X

    def _compute_causal_matrix(self, Y, X, B):
        k = self.num_signals
        causal = np.zeros((k, k))

        residuals = Y - (X @ B)
        rss = np.sum(residuals ** 2, axis=0)

        df = len(Y) - X.shape[1]

        if df <= 0:
            return causal

        for i in range(k):
            for j in range(k):
                if i == j:
                    continue

                idx = [lag * k + i for lag in range(self.max_lags)]
                beta = B[idx, j]

                strength = np.sum(beta ** 2)

                if strength > 0:
                    f = strength / (rss[j] + 1e-9)

                    if f > self.alpha:
                        causal[i, j] = f

        return causal
